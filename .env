DATABASE_URL="postgresql://miusuario:1234@localhost:5433/midb2?schema=public"

# --- Backend (@reto/backend) ---
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# JWT (RF-01). Cambiar en producción por secretos fuertes y distintos entre sí.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_TEMP_EXPIRES_IN="5m"

# Correo (RF-04). Deja SMTP_HOST vacío para modo simulado (solo consola).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="tucorreo@gmail.com"
SMTP_PASS="contraseña-de-aplicación"   # no la contraseña normal de Gmail
MAIL_FROM="RETO <tucorreo@gmail.com>"
