// ============================================================================
// SCHEMA PRISMA - Sistema PWA de Evaluación Basada en Riesgo (EBR/BPM)
// ============================================================================
// Este archivo contiene DOS bloques:
//
//   [A] MODELOS YA EXISTENTES EN LA BD (tomados de diagrama0.json / Lucidchart)
//       Se declaran para que Prisma pueda resolver las relaciones hacia ellos.
//       Están marcados con el comentario "// [EXISTENTE]". Los campos marcados
//       con "// [NUEVO]" dentro de estos modelos son columnas que HAY que
//       agregar vía migración porque el SRS los pide y hoy no existen.
//
//   [B] MODELOS NUEVOS a crear, agrupados por el requerimiento (RF-xx) del SRS
//       que cubren.
//
// Convención: nombres de tabla/columna en snake_case (igual que el ERD ya
// creado), mapeados con @map/@@map para mantener estilo camelCase en Prisma.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// [A] MODELOS EXISTENTES (referencia, extraídos de diagrama0.json)
// ============================================================================

/// [EXISTENTE] RF-01 / RF-02 - Persona física base (usuarios, propietarios, representantes)
model Person {
  personId Int    @id @default(autoincrement()) @map("person_id")
  name     String
  cedula   String @unique
  phone    String
  email    String @unique

  user       User?
  propietary Propietary?
  represents Represent[]

  @@map("person")
}

/// [EXISTENTE] RF-01 - Credenciales de acceso
/// [NUEVO] roleId, status, campos de recuperación/2FA se agregan vía relaciones abajo (B.1)
model User {
  userId   Int    @id @default(autoincrement()) @map("user_id")
  personId Int    @unique @map("person_id")
  password String

  // [NUEVO] necesarios para RF-01/RF-02/RNF-02
  roleId    Int?       @map("role_id")
  status    UserStatus @default(PENDIENTE_VALIDACION) // [NUEVO]
  isActive  Boolean    @default(true) @map("is_active") // [NUEVO]
  createdAt DateTime   @default(now()) @map("created_at") // [NUEVO]

  person              Person               @relation(fields: [personId], references: [personId])
  role                Role?                @relation(fields: [roleId], references: [roleId])
  passwordResets      PasswordResetToken[]
  twoFactorAuth       TwoFactorAuth?
  notifications       Notification[]
  coordinatedCases    Case[]               @relation("CaseCoordinator")
  technicianCases     Case[]               @relation("CaseTechnician")
  assignmentsMade     Assignment[]         @relation("AssignedBy")
  assignmentsTaken    Assignment[]         @relation("AssignedTo")
  evaluationsRun      Evaluation[]         @relation("EvaluationTechnician")
  reviewsDone         ReportReview[]
  attachmentsUploaded Attachment[]
  bpmRequestsCreated  BpmRequest[]

  @@map("user")
}

/// [EXISTENTE] Dueño de una institución (empresa)
model Propietary {
  propietaryId Int @id @default(autoincrement()) @map("propietary_id")
  personId     Int @unique @map("person_id")

  person       Person        @relation(fields: [personId], references: [personId])
  institutions Institution[]

  @@map("propietary")
}

/// [EXISTENTE] RF-03 - Representante de una empresa (legal / calidad / contacto)
/// [NUEVO] institutionId + tipo: hoy solo enlaza a person; el SRS pide 3 tipos de
/// representante por empresa (Legal, Calidad, Contacto principal).
model Represent {
  representId Int @id @default(autoincrement()) @map("represent_id")
  personId    Int @map("person_id")

  institutionId Int?           @map("institution_id") // [NUEVO]
  type          RepresentType? // [NUEVO] LEGAL | CALIDAD | CONTACTO

  person        Person         @relation(fields: [personId], references: [personId])
  institution   Institution?   @relation(fields: [institutionId], references: [institutionId])
  formResponses FormResponse[]

  @@map("represent")
}

/// [EXISTENTE] RF-03 - Empresa / establecimiento
/// [NUEVO] nombreComercial, actividadEconomica, municipalityId reemplazan los
/// campos libres de municipio/provincia del SRS por catálogo normalizado.
model Institution {
  institutionId Int    @id @default(autoincrement()) @map("institution_id")
  name          String
  streetName    String @map("street_name")
  streetNum     Int    @map("street_num")
  phoneNumber   String @map("phone_number")
  email         String
  rnc           String
  propietaryId  Int    @map("propietary_id")

  // [NUEVO] campos pedidos en RF-03
  nombreComercial    String? @map("nombre_comercial")
  actividadEconomica String? @map("actividad_economica")
  municipalityId     Int?    @map("municipality_id")

  propietary     Propietary          @relation(fields: [propietaryId], references: [propietaryId])
  municipality   Municipality?       @relation(fields: [municipalityId], references: [municipalityId])
  formResponses  FormResponse[]
  status         InstitutionStatus[]
  saPermits      SaPermit[]
  representantes Represent[]
  bpmRequests    BpmRequest[]
  cases          Case[]
  lapchAlerts    LapchAlert[]
  complaints     Complaint[]
  evaluations    Evaluation[]

  @@map("institution")
}

/// [EXISTENTE] Estado / certificación vigente de una institución
model InstitutionStatus {
  institutionStatusId Int      @id @default(autoincrement()) @map("institution_status_id")
  institutionId       Int      @map("institution_id")
  validUntil          DateTime @map("valid_until")

  institution Institution                 @relation(fields: [institutionId], references: [institutionId])
  questions   InstitutionStatusQuestion[]

  @@map("institution_status")
}

/// [EXISTENTE]
model InstitutionStatusQuestion {
  institutionStatusQuestionId Int    @id @default(autoincrement()) @map("institution_status_question_id")
  institutionStatusId         Int    @map("institution_status_id")
  question                    String
  type                        String
  value                       String

  institutionStatus InstitutionStatus @relation(fields: [institutionStatusId], references: [institutionStatusId])

  @@map("institution_status_question")
}

/// [EXISTENTE] Permiso Sanitario
model SaPermit {
  saPermitId     Int      @id @default(autoincrement()) @map("sa_permit_uuid")
  expiration     DateTime
  formResponseId Int      @map("form_response_id")
  valid          Boolean
  institutionId  Int      @map("institution_id")

  formResponse FormResponse @relation(fields: [formResponseId], references: [formResponseId])
  institution  Institution  @relation(fields: [institutionId], references: [institutionId])

  @@map("sa_permit")
}

/// [EXISTENTE] Categoría de alimento
model Category {
  categoryId Int    @id @default(autoincrement()) @map("category_id")
  name       String

  subCategories SubCategory[]
  foods         Food[]

  @@map("category")
}

/// [EXISTENTE] RF-14 - Subcategoría con nivel de riesgo (Matriz_Riesgo_Alimentos.xlsx)
model SubCategory {
  subCategoryId Int    @id @default(autoincrement()) @map("sub_category_id")
  categoryId    Int    @map("category_id")
  name          String
  risk          Int

  category Category @relation(fields: [categoryId], references: [categoryId])

  @@map("sub_category")
}

/// [EXISTENTE]
model Food {
  foodId     Int    @id @default(autoincrement()) @map("food_id")
  name       String
  categoryId Int    @map("category_id")

  category      Category       @relation(fields: [categoryId], references: [categoryId])
  formResponses FormResponse[]

  @@map("food")
}

/// [EXISTENTE] Plantilla de ficha (ej. "Ficha Inspección BPM v1.00")
model FormTemplate {
  formTemplateId Int      @id @default(autoincrement()) @map("form_template_id")
  name           String
  active         Boolean
  createAt       DateTime @map("create_at")

  h1s           H1[]
  formResponses FormResponse[]

  @@map("form_template")
}

/// [EXISTENTE] RF-12/RF-13 - Ficha diligenciada (respuestas en JSONB)
model FormResponse {
  formResponseId Int      @id @default(autoincrement()) @map("form_response_id")
  name           String
  createAt       DateTime @map("create_at")
  formTemplateId Int      @map("form_template_id")
  institutionId  Int      @map("institution_id")
  representId    Int      @map("represent_id")
  foodId         Int      @map("food_id")
  motive         String
  answers        Json

  formTemplate FormTemplate @relation(fields: [formTemplateId], references: [formTemplateId])
  institution  Institution  @relation(fields: [institutionId], references: [institutionId])
  represent    Represent    @relation(fields: [representId], references: [representId])
  food         Food         @relation(fields: [foodId], references: [foodId])
  saPermits    SaPermit[]
  evaluation   Evaluation?
  bpmRequest   BpmRequest?

  @@map("form_response")
}

/// [EXISTENTE] Nivel 1 de la jerarquía de la ficha (ej. "1. ESTABLECIMIENTO")
model H1 {
  h1Id           Int    @id @default(autoincrement()) @map("h1_id")
  name           String
  formId         Int    @map("form_id")
  formTemplateId Int    @map("form_template_id")

  formTemplate FormTemplate @relation(fields: [formTemplateId], references: [formTemplateId])
  h1Asks       H1Ask[]
  h2s          H2[]

  @@map("h1")
}

/// [EXISTENTE]
model H1Ask {
  h1AskId Int     @id @default(autoincrement()) @map("h1_ask_id")
  name    String
  h1Id    Int     @map("h1_id")
  active  Boolean

  h1 H1 @relation(fields: [h1Id], references: [h1Id])

  @@map("h1_ask")
}

/// [EXISTENTE] Nivel 2 (ej. "1.1 Ubicación y estructura")
model H2 {
  h2Id Int    @id @default(autoincrement()) @map("h2_id")
  h1Id Int    @map("h1_id")
  name String

  h1     H1      @relation(fields: [h1Id], references: [h1Id])
  h2Asks H2Ask[]
  h3s    H3[]

  @@map("h2")
}

/// [EXISTENTE]
model H2Ask {
  h2AskId Int     @id @default(autoincrement()) @map("h2_ask_id")
  name    String
  h2Id    Int     @map("h2_id")
  active  Boolean

  h2 H2 @relation(fields: [h2Id], references: [h2Id])

  @@map("h2_ask")
}

/// [EXISTENTE] Nivel 3 (ej. "1.1.1 Ubicación del establecimiento")
model H3 {
  h3Id Int    @id @default(autoincrement()) @map("h3_id")
  h2Id Int    @map("h2_id")
  name String

  h2     H2      @relation(fields: [h2Id], references: [h2Id])
  h3Asks H3Ask[]
  h4s    H4[]

  @@map("h3")
}

/// [EXISTENTE]
model H3Ask {
  h3AskId Int     @id @default(autoincrement()) @map("h3_ask_id")
  name    String
  h3Id    Int     @map("h3_id")
  active  Boolean

  h3 H3 @relation(fields: [h3Id], references: [h3Id])

  @@map("h3_ask")
}

/// [EXISTENTE] Nivel 4 (ej. "1.1.3.1 Paredes")
model H4 {
  h4Id Int    @id @default(autoincrement()) @map("h4_id")
  h3Id Int    @map("h3_id")
  name String

  h3     H3      @relation(fields: [h3Id], references: [h3Id])
  h4Asks H4Ask[]

  @@map("h4")
}

/// [EXISTENTE]
model H4Ask {
  h4AskId Int     @id @default(autoincrement()) @map("h4_ask_id")
  name    String
  h4Id    Int     @map("h4_id")
  active  Boolean

  h4 H4 @relation(fields: [h4Id], references: [h4Id])

  @@map("h4_ask")
}

/// [EXISTENTE] Bitácora de cambios sobre una pregunta (h_id genérico + h_num)
model AskAuditory {
  askAuditoryId Int      @id @default(autoincrement()) @map("ask_auditory_id")
  hId           String   @map("h_id")
  hNum          Int      @map("h_num")
  createAt      DateTime @map("create_at")
  action        String

  @@map("ask_auditory")
}

// ============================================================================
// [B] MODELOS NUEVOS - agrupados por requerimiento del SRS
// ============================================================================

// ---------------------------------------------------------------------------
// B.1 - RF-01 Autenticación / RF-02 Registro de usuarios / RNF-02 Seguridad
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDIENTE_VALIDACION
  APROBADO
  RECHAZADO
}

/// RF-02 - catálogo de roles (Administrador, Administrador Empresa, Usuario
/// Delegado, Coordinador, Técnico Evaluador) usado para RBAC (RNF-02)
model Role {
  roleId      Int     @id @default(autoincrement()) @map("role_id")
  name        String  @unique
  description String?

  users User[]

  @@map("role")
}

/// RF-01 - Recuperación de contraseña
model PasswordResetToken {
  tokenId   Int      @id @default(autoincrement()) @map("token_id")
  userId    Int      @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("password_reset_token")
}

/// RF-01 - Doble factor de autenticación (opcional)
model TwoFactorAuth {
  userId  Int     @id @map("user_id")
  secret  String
  enabled Boolean @default(false)

  user User @relation(fields: [userId], references: [userId])

  @@map("two_factor_auth")
}

// ---------------------------------------------------------------------------
// B.2 - Catálogos de ubicación (soporte a RF-03: Municipio / Provincia / Área de Salud)
// ---------------------------------------------------------------------------

model Province {
  provinceId Int    @id @default(autoincrement()) @map("province_id")
  name       String @unique

  municipalities Municipality[]

  @@map("province")
}

model Municipality {
  municipalityId Int    @id @default(autoincrement()) @map("municipality_id")
  provinceId     Int    @map("province_id")
  name           String

  province     Province      @relation(fields: [provinceId], references: [provinceId])
  institutions Institution[]

  @@map("municipality")
}

/// Catálogo "Área de Salud" (I a VIII) visto en la Ficha BPM
model HealthArea {
  healthAreaId Int    @id @default(autoincrement()) @map("health_area_id")
  name         String @unique

  @@map("health_area")
}

// ---------------------------------------------------------------------------
// B.3 - Documentos / adjuntos genéricos
// Cubre: RF-02 (carta de autorización), RF-05 (documentación obligatoria),
// RF-15 (evidencias), RF-16 (informe), RF-19 (informe oficial PDF)
// ---------------------------------------------------------------------------

enum AttachmentCategory {
  CARTA_AUTORIZACION
  DOCUMENTACION_OBLIGATORIA
  EVIDENCIA_FOTO
  EVIDENCIA_VIDEO
  EVIDENCIA_DOCUMENTO
  INFORME_ADJUNTO
  INFORME_OFICIAL_PDF
  OTRO
}

/// Tabla genérica de adjuntos; se relaciona opcionalmente con cada entidad
/// que puede recibir archivos (una sola de las FKs va poblada por registro).
model Attachment {
  attachmentId Int                @id @default(autoincrement()) @map("attachment_id")
  category     AttachmentCategory
  fileName     String             @map("file_name")
  fileUrl      String             @map("file_url")
  mimeType     String?            @map("mime_type")
  uploadedById Int?               @map("uploaded_by")
  createdAt    DateTime           @default(now()) @map("created_at")

  userRegistrationId Int? @map("user_registration_id") // RF-02: carta de autorización
  bpmRequestId       Int? @map("bpm_request_id") // RF-05: documentación obligatoria
  evaluationReportId Int? @map("evaluation_report_id") // RF-16: fotos/documentos del informe
  caseId             Int? @map("case_id") // RF-19: informe oficial PDF

  uploadedBy       User?             @relation(fields: [uploadedById], references: [userId])
  bpmRequest       BpmRequest?       @relation(fields: [bpmRequestId], references: [bpmRequestId])
  evaluationReport EvaluationReport? @relation(fields: [evaluationReportId], references: [reportId])
  case             Case?             @relation(fields: [caseId], references: [caseId])

  @@map("attachment")
}

// ---------------------------------------------------------------------------
// B.4 - RF-05 Solicitudes BPM
// ---------------------------------------------------------------------------

enum BpmRequestStatus {
  BORRADOR
  PENDIENTE_ASIGNACION
  EN_REVISION
  RECHAZADA
  APROBADA
}

model BpmRequest {
  bpmRequestId        Int              @id @default(autoincrement()) @map("bpm_request_id")
  institutionId       Int              @map("institution_id")
  tipoEstablecimiento String           @map("tipo_establecimiento")
  motivo              String
  observaciones       String?
  status              BpmRequestStatus @default(BORRADOR)
  createdById         Int              @map("created_by")
  createdAt           DateTime         @default(now()) @map("created_at")
  sentAt              DateTime?        @map("sent_at")

  // vínculo opcional a la ficha diligenciada resultante (RF-12/13)
  formResponseId Int? @unique @map("form_response_id")

  institution  Institution   @relation(fields: [institutionId], references: [institutionId])
  createdBy    User          @relation(fields: [createdById], references: [userId])
  formResponse FormResponse? @relation(fields: [formResponseId], references: [formResponseId])
  attachments  Attachment[]
  case         Case?

  @@map("bpm_request")
}

// ---------------------------------------------------------------------------
// B.5 - RF-06 Gestión de casos / RF-19 Cierre de expediente
// ---------------------------------------------------------------------------

enum CaseOrigin {
  SOLICITUD_EMPRESA
  PROGRAMACION_INSTITUCIONAL
  ALERTA_LAPCH
  DENUNCIA
}

enum CasePriority {
  BAJA
  MEDIA
  ALTA
}

enum CaseStatus {
  ABIERTO
  ASIGNADO
  EN_EVALUACION
  EN_REVISION
  CERRADO
}

/// RF-06/RF-10/RF-19 - Expediente: unifica el origen (solicitud, programación,
/// alerta o denuncia), la asignación de coordinador/técnico y el cierre.
model Case {
  caseId        Int          @id @default(autoincrement()) @map("case_id")
  origin        CaseOrigin
  institutionId Int          @map("institution_id")
  priority      CasePriority @default(MEDIA)
  status        CaseStatus   @default(ABIERTO)

  coordinatorId Int? @map("coordinator_id")
  technicianId  Int? @map("technician_id")

  // exactamente una de estas 3 debe estar poblada según "origin"
  bpmRequestId Int? @unique @map("bpm_request_id")
  lapchAlertId Int? @unique @map("lapch_alert_id")
  complaintId  Int? @unique @map("complaint_id")

  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  resultadoFinal String?   @map("resultado_final")

  institution Institution @relation(fields: [institutionId], references: [institutionId])
  coordinator User?       @relation("CaseCoordinator", fields: [coordinatorId], references: [userId])
  technician  User?       @relation("CaseTechnician", fields: [technicianId], references: [userId])
  bpmRequest  BpmRequest? @relation(fields: [bpmRequestId], references: [bpmRequestId])
  lapchAlert  LapchAlert? @relation(fields: [lapchAlertId], references: [alertId])
  complaint   Complaint?  @relation(fields: [complaintId], references: [complaintId])

  assignments Assignment[]
  evaluations Evaluation[]
  attachments Attachment[] // informe oficial PDF, etc.

  @@map("case")
}

// ---------------------------------------------------------------------------
// B.6 - RF-08 Alertas LAPCH
// ---------------------------------------------------------------------------

enum LapchResult {
  PROCEDE
  NO_PROCEDE
}

model LapchAlert {
  alertId       Int          @id @default(autoincrement()) @map("alert_id")
  numeroAlerta  String       @map("numero_alerta")
  fecha         DateTime
  producto      String
  institutionId Int          @map("institution_id")
  descripcion   String
  resultado     LapchResult?
  createdAt     DateTime     @default(now()) @map("created_at")

  institution Institution @relation(fields: [institutionId], references: [institutionId])
  case        Case?

  @@map("lapch_alert")
}

// ---------------------------------------------------------------------------
// B.7 - RF-09 Denuncias
// ---------------------------------------------------------------------------

enum ComplaintResult {
  PROCEDE
  NO_PROCEDE
  REMISION_OTRO_PROCESO
}

model Complaint {
  complaintId    Int              @id @default(autoincrement()) @map("complaint_id")
  tipoDenuncia   String           @map("tipo_denuncia")
  fechaRecepcion DateTime         @map("fecha_recepcion")
  denunciante    String
  descripcion    String
  resultado      ComplaintResult?
  institutionId  Int?             @map("institution_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  institution Institution? @relation(fields: [institutionId], references: [institutionId])
  case        Case?

  @@map("complaint")
}

// ---------------------------------------------------------------------------
// B.8 - RF-10 Asignación de evaluador (historial de asignación/reasignación)
// ---------------------------------------------------------------------------

model Assignment {
  assignmentId   Int      @id @default(autoincrement()) @map("assignment_id")
  caseId         Int      @map("case_id")
  assignedToId   Int      @map("assigned_to")
  assignedById   Int      @map("assigned_by")
  isReassignment Boolean  @default(false) @map("is_reassignment")
  notes          String?
  assignedAt     DateTime @default(now()) @map("assigned_at")

  case       Case @relation(fields: [caseId], references: [caseId])
  assignedTo User @relation("AssignedTo", fields: [assignedToId], references: [userId])
  assignedBy User @relation("AssignedBy", fields: [assignedById], references: [userId])

  @@map("assignment")
}

// ---------------------------------------------------------------------------
// B.9 - RF-07 Programación / RF-11 Calendario / RF-12 Ejecución de evaluación
// ---------------------------------------------------------------------------

enum EvaluationStatus {
  PROGRAMADA
  REPROGRAMADA
  CANCELADA
  EN_PROCESO
  FINALIZADA
}

/// Envuelve la ficha (FormResponse ya existente) con programación, técnico
/// asignado y estado del proceso de campo.
model Evaluation {
  evaluationId  Int @id @default(autoincrement()) @map("evaluation_id")
  caseId        Int @map("case_id")
  institutionId Int @map("institution_id")
  technicianId  Int @map("technician_id")

  scheduledDate DateTime         @map("scheduled_date")
  reason        String?
  priority      CasePriority     @default(MEDIA)
  observations  String?
  status        EvaluationStatus @default(PROGRAMADA)

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  // ficha diligenciada (RF-12/RF-13), ya existente
  formResponseId Int? @unique @map("form_response_id")

  createdAt DateTime @default(now()) @map("created_at")

  case         Case          @relation(fields: [caseId], references: [caseId])
  institution  Institution   @relation(fields: [institutionId], references: [institutionId])
  technician   User          @relation("EvaluationTechnician", fields: [technicianId], references: [userId])
  formResponse FormResponse? @relation(fields: [formResponseId], references: [formResponseId])

  score     EvaluationScore?
  evidences Evidence[]
  report    EvaluationReport?

  @@map("evaluation")
}

// ---------------------------------------------------------------------------
// B.10 - RF-14 Motor de riesgo
// ---------------------------------------------------------------------------

enum RiskLevel {
  BAJO
  MEDIO
  ALTO
}

enum InspectionFrequency {
  ANUAL
  SEMESTRAL
  TRIMESTRAL
}

/// Tabla de referencia estática = "Matriz de Frecuencia de Inspección" del SRS
/// (1.0-3.6 => Bajo/Anual, >3.6-6.3 => Medio/Semestral, >6.3 => Alto/Trimestral)
model RiskFrequencyRule {
  ruleId    Int                 @id @default(autoincrement()) @map("rule_id")
  minScore  Float               @map("min_score")
  maxScore  Float?              @map("max_score")
  riskLevel RiskLevel           @map("risk_level")
  frequency InspectionFrequency

  @@map("risk_frequency_rule")
}

/// Resultado calculado automáticamente por evaluación (puntaje, % cumplimiento, nivel)
model EvaluationScore {
  evaluationId           Int                 @id @map("evaluation_id")
  puntajeObtenido        Float               @map("puntaje_obtenido")
  porcentajeCumplimiento Float               @map("porcentaje_cumplimiento")
  nivelRiesgo            RiskLevel           @map("nivel_riesgo")
  frecuenciaInspeccion   InspectionFrequency @map("frecuencia_inspeccion")
  calculatedAt           DateTime            @default(now()) @map("calculated_at")

  evaluation Evaluation @relation(fields: [evaluationId], references: [evaluationId])

  @@map("evaluation_score")
}

// ---------------------------------------------------------------------------
// B.11 - RF-15 Captura de evidencias
// ---------------------------------------------------------------------------

enum EvidenceType {
  FOTO
  VIDEO
  DOCUMENTO
}

model Evidence {
  evidenceId   Int          @id @default(autoincrement()) @map("evidence_id")
  evaluationId Int          @map("evaluation_id")
  type         EvidenceType
  fileUrl      String       @map("file_url")
  latitude     Float?
  longitude    Float?
  comment      String?
  capturedAt   DateTime     @default(now()) @map("captured_at")

  // referencia opcional a la pregunta específica de la ficha (h1..h4 ask)
  h1AskId Int? @map("h1_ask_id")
  h2AskId Int? @map("h2_ask_id")
  h3AskId Int? @map("h3_ask_id")
  h4AskId Int? @map("h4_ask_id")

  evaluation Evaluation @relation(fields: [evaluationId], references: [evaluationId])

  @@map("evidence")
}

// ---------------------------------------------------------------------------
// B.12 - RF-16 Informe / RF-17 Revisión del coordinador / RF-18 Correcciones
// ---------------------------------------------------------------------------

enum ReportStatus {
  BORRADOR
  ENVIADO
  APROBADO
  DEVUELTO
  EN_CORRECCION
}

/// RF-16 - Informe generado automáticamente a partir de la evaluación
model EvaluationReport {
  reportId         Int          @id @default(autoincrement()) @map("report_id")
  evaluationId     Int          @unique @map("evaluation_id")
  resumenEjecutivo String       @map("resumen_ejecutivo")
  hallazgos        String
  noConformidades  String       @map("no_conformidades")
  recomendaciones  String
  status           ReportStatus @default(BORRADOR)
  version          Int          @default(1) // se incrementa en cada corrección (RF-18)
  locked           Boolean      @default(false) // RF-17: se bloquea tras enviarse
  generatedAt      DateTime     @default(now()) @map("generated_at")

  evaluation  Evaluation     @relation(fields: [evaluationId], references: [evaluationId])
  attachments Attachment[]
  reviews     ReportReview[]

  @@map("evaluation_report")
}

enum ReviewAction {
  APROBAR
  DEVOLVER
  SOLICITAR_CORRECCION
}

/// RF-17/RF-18 - Cada acción del coordinador sobre un informe (y su posterior
/// corrección/reenvío por parte del técnico)
model ReportReview {
  reviewId      Int          @id @default(autoincrement()) @map("review_id")
  reportId      Int          @map("report_id")
  coordinatorId Int          @map("coordinator_id")
  action        ReviewAction
  comments      String?
  reviewedAt    DateTime     @default(now()) @map("reviewed_at")

  report      EvaluationReport @relation(fields: [reportId], references: [reportId])
  coordinator User             @relation(fields: [coordinatorId], references: [userId])

  @@map("report_review")
}

// ---------------------------------------------------------------------------
// B.13 - RF-04 Notificaciones (dashboards)
// ---------------------------------------------------------------------------

model Notification {
  notificationId Int      @id @default(autoincrement()) @map("notification_id")
  userId         Int      @map("user_id")
  title          String
  message        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [userId])

  @@map("notification")
}

// ---------------------------------------------------------------------------
// B.14 - RepresentType (apoyo a B.2 / Institution.Represent)
// ---------------------------------------------------------------------------

enum RepresentType {
  LEGAL
  CALIDAD
  CONTACTO
}
