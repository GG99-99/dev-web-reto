# Copy this file to `.env` in the repository root. The backend and Prisma read that file.
# Do not commit `.env`.

# PostgreSQL from docker-pg/docker-compose.yml (host port 5433, database midb2).
DATABASE_URL="postgresql://miusuario:1234@localhost:5433/midb2?schema=public"

# Backend
PORT=3000
# Browser origins allowed to call the API. Comma-separated. Dev UI is Vite on 5173.
CORS_ORIGIN="http://localhost:5173"

# Links in password-recovery email. Use the URL people open in the browser.
APP_PUBLIC_URL="http://localhost:5173"
# Origin encoded in official-report QR codes. A phone can only open this if it can reach the host.
# In dev, the Vite app is http://localhost:5173. `pnpm prod` serves the app from the backend on PORT.
PUBLIC_APP_URL="http://localhost:5173"

# JWT. Use long, different values in any shared environment.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_TEMP_EXPIRES_IN="5m"
# Optional. QR seals fall back to JWT_ACCESS_SECRET when this is empty.
DOCUMENT_SEAL_SECRET=""

# Mail. Leave SMTP_HOST empty to print messages in the backend console instead of sending them.
# Gmail: use an app password, not the account password. If port 587 is blocked, use 465 and SMTP_SECURE=true.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="RADAR Sanitario <no-reply@localhost>"
